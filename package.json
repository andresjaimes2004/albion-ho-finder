{
  "name": "albion-ho-finder",
  "version": "1.0.0",
  "description": "Buscador de Hideouts de Zona Negra por gremio con mapa interactivo, cuentas de usuario y panel de administración - Albion Online",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/importarSeed.js",
    "db:import": "node scripts/importarExcel.js",
    "test": "node --test tests/*.test.js",
    "db:geo": "node scripts/importarGeo.js",
    "db:generar-geo": "node scripts/generarGeoDesdeDumps.js",
    "db:generar-caminos": "node scripts/generarCaminosDesdeDumps.js",
    "db:generar-zonas": "node scripts/generarZonasDesdeDumps.js"
  },
  "dependencies": {},
  "license": "MIT",
  "optionalDependencies": {
    "xlsx": "^0.18.5"
  }
}
