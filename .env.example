# Puerto en el que escucha el servidor (Render/Railway lo inyectan automáticamente)
PORT=3000

# Ruta del archivo de base de datos SQLite. En la mayoría de hostings basta
# con dejarlo vacío para usar la ruta por defecto (./database/albion.db).
# En plataformas con disco efímero, apunta a un volumen persistente, ej:
# DB_PATH=/data/albion.db
DB_PATH=

# Ponlo en "production" al desplegar: activa cookies Secure (solo HTTPS) y
# la cabecera HSTS.
NODE_ENV=

# Cuenta de administrador que se crea en el primer arranque. Si no las
# defines, se crea el usuario "admin" con una contraseña aleatoria que se
# imprime UNA vez en el log del servidor.
# Usa una contraseña larga (mínimo 10 caracteres, con letras y números).
ADMIN_USUARIO=
ADMIN_CLAVE=


# URL pública del sitio, sin barra final. Se usa en la URL canónica, los
# enlaces entre idiomas (hreflang), robots.txt y sitemap.xml.
# Por defecto: https://albionho.duckdns.org
SITIO_URL=

# Códigos de verificación de propiedad del sitio (opcionales): el valor del
# atributo "content" de la etiqueta <meta> que dan Google Search Console y
# Bing Webmaster Tools al elegir el método "Etiqueta HTML".
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Donaciones (opcionales). Sin valor, o con un valor inválido, la opción
# aparece como "muy pronto".
#  - DONAR_KOFI_URL: tu página de Ko-fi, p. ej. https://ko-fi.com/turndark
#  - DONAR_BREB_LLAVE: tu llave Bre-B; mejor la alfanumérica (p. ej. @turndark)
#    que el celular o la cédula, para no publicar datos personales.
#  - El QR de Bre-B se muestra si existe public/assets/qr-breb.png.
DONAR_KOFI_URL=
DONAR_BREB_LLAVE=

# Soporte y redes (opcionales). Sin valor, o con un valor inválido, el
# correo aparece como "muy pronto" en Contáctanos y el icono de Discord no
# se muestra en el pie.
#  - DISCORD_URL: invitación a tu servidor (https://discord.gg/xxxx o
#    https://discord.com/invite/xxxx) o tu perfil (https://discord.com/users/<id>).
#  - CONTACTO_CORREO: correo de contacto, p. ej. soporte@tudominio.com
DISCORD_URL=
CONTACTO_CORREO=
