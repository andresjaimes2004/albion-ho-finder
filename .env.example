# Puerto en el que escucha el servidor (Render/Railway lo inyectan automáticamente)
PORT=3000

# Ruta del archivo de base de datos SQLite. En la mayoría de hostings basta
# con dejarlo vacío para usar la ruta por defecto (./database/albion.db).
# En plataformas con disco efímero, apunta a un volumen persistente, ej:
# DB_PATH=/data/albion.db
DB_PATH=
